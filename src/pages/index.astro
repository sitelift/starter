---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SiteLift starter" description="Clone-per-client Astro template">
	<main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-16">
		<p class="text-sm font-medium uppercase tracking-wide text-slate-500">SiteLift.net</p>
		<h1 class="mt-2 text-4xl font-semibold tracking-tight">Client site starter</h1>
		<p class="mt-4 text-lg text-slate-600">
			Astro, Tailwind, MDX, and TypeScript. Fill in <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm">client.md</code> and start building.
		</p>
		<p class="mt-8">
			<a href="/example" class="text-slate-900 underline underline-offset-4 hover:text-slate-600">
				See the example content page →
			</a>
		</p>
	</main>
</Layout>
